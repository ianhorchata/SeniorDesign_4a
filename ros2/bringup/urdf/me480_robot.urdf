<?xml version="1.0"?>
<!-- Visual model of ME480Robot.proto for RViz. Keep dimensions in sync with the PROTO. -->
<robot name="ME480Robot">
  <material name="red"><color rgba="1 0 0 1"/></material>
  <material name="purple"><color rgba="0.2 0 1 1"/></material>
  <material name="grey"><color rgba="0.3 0.3 0.3 1"/></material>

  <link name="base_link">
    <visual>
      <geometry><box size="0.2 0.1 0.05"/></geometry>
      <material name="red"/>
    </visual>
  </link>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.02" length="0.02"/></geometry>
      <material name="grey"/>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
  </joint>

  <link name="wheel1_link">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.04" length="0.02"/></geometry>
      <material name="purple"/>
    </visual>
  </link>
  <joint name="wheel1_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel1_link"/>
    <origin xyz="0.05 0.06 -0.025"/>
  </joint>

  <link name="wheel2_link">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.04" length="0.02"/></geometry>
      <material name="purple"/>
    </visual>
  </link>
  <joint name="wheel2_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel2_link"/>
    <origin xyz="0.05 -0.06 -0.025"/>
  </joint>

  <link name="wheel3_link">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.04" length="0.02"/></geometry>
      <material name="purple"/>
    </visual>
  </link>
  <joint name="wheel3_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel3_link"/>
    <origin xyz="-0.05 0.06 -0.025"/>
  </joint>

  <link name="wheel4_link">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.04" length="0.02"/></geometry>
      <material name="purple"/>
    </visual>
  </link>
  <joint name="wheel4_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel4_link"/>
    <origin xyz="-0.05 -0.06 -0.025"/>
  </joint>
</robot>
